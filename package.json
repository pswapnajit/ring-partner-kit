{
  "name": "ring-partner-kit",
  "version": "0.1.0",
  "description": "Typed, zero-dependency toolkit for the Ring Partner API (Amazon Vision API): client, webhook verification, sensor and chime helpers, and a contract-faithful local simulator.",
  "type": "module",
  "license": "MIT",
  "author": "Swapnajit Patra",
  "keywords": [
    "ring",
    "ring-appstore",
    "amazon-vision",
    "webhooks",
    "hmac",
    "simulator",
    "smart-home"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./sim": "./src/sim/index.ts"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.ts\"",
    "sim": "node src/sim/cli.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pswapnajit/ring-partner-kit.git"
  },
  "homepage": "https://github.com/pswapnajit/ring-partner-kit#readme"
}
